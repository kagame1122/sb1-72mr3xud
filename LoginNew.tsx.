
import React, { useState } from 'react';
import { supabase } from '../supabase';

const LoginNew: React.FC = () => {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [message, setMessage] = useState('');
  const [loading, setLoading] = useState(false);

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    setMessage('');

    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    setLoading(false);

    if (error) {
      setMessage('Kwinjira byanze: ' + error.message);
    } else {
      setMessage('Winjiye neza! Murakaza neza muri RUBAVU ONLINE MARKET.');
    }
  };

  return (
    <div className="min-h-screen bg-gray-100 flex items-center justify-center px-4">
      <div className="w-full max-w-md bg-white rounded-2xl shadow-lg p-6">
        <h1 className="text-3xl font-bold text-center text-emerald-700 mb-2">
          RUBAVU ONLINE MARKET
        </h1>

        <p className="text-center text-gray-600 mb-6">
          Injira muri konti yawe
        </p>

        <form onSubmit={handleLogin} className="space-y-4">
          <input
            type="email"
            placeholder="Andika Email yawe"
            value={email}
            onChange={(e) => setEmail(e.target.value)}
            required
            className="w-full border rounded-lg p-3"
          />

          <input
            type="password"
            placeholder="Ijambo ry'ibanga"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            required
            className="w-full border rounded-lg p-3"
          />

          {message && (
            <p className="text-center text-sm text-blue-700">
              {message}
            </p>
          )}

          <button
            type="submit"
            disabled={loading}
            className="w-full bg-emerald-600 text-white font-bold py-3 rounded-lg disabled:opacity-50"
          >
            {loading ? 'Tegereza...' : 'INJIRA'}
          </button>
        </form>
      </div>
    </div>
  );
};

export default LoginNew;
